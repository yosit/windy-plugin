{
  "name": "@yosit/runline-plugin-windy",
  "version": "1.0.5",
  "description": "Runline plugin exposing the windy.com API (forecasts, stations, alerts, storms, webcams, tides, geo).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "src/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "runline",
