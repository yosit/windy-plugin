{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": [
      "ES2020"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/client.ts",
    "src/catalog.ts",
    "src/index.ts",
    "src/session.ts",
    "src/types.ts",
    "src/version.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}